! Short integration check ONLY: not the paper domain or production resolution.
&filelist
 base_filename='output/mp5_3'
 autoconvert=.true.
 convert_type='vtuBCCmpi'
 saveprim=.true.
 nwauxio=1
/
&savelist
 itsave(1,1)=0
 itsave(1,2)=0
 dtsave(1)=0.1d0
 dtsave(2)=0.1d0
/
&stoplist
 time_max=0.2d0
 dtmin=1.d-12
/
&methodlist
 time_stepper='threestep'
 flux_scheme=20*'tvdlf'
 limiter=20*'mp5'
 small_values_method='error'
/
&boundlist
 nghostcells=3
 ! Five HD BC entries; tracer follows density (need_bc=F in this version).
 typeboundary_min1=5*'cont'
 typeboundary_max1=5*'cont'
 typeboundary_min2=5*'special'
 typeboundary_max2=5*'cont'
 typeboundary_min3=5*'cont'
 typeboundary_max3=5*'cont'
/
&meshlist
 refine_max_level=1
 block_nx1=8
 block_nx2=8
 block_nx3=8
 domain_nx1=32
 domain_nx2=32
 domain_nx3=32
 xprobmin1=-4.d0
 xprobmax1=4.d0
 xprobmin2=0.d0
 xprobmax2=8.d0
 xprobmin3=-4.d0
 xprobmax3=4.d0
/
&paramlist
 courantpar=0.3d0
 typecourant='maxsum'
/
&hd_list
 hd_energy=.true.
 hd_n_tracer=1
/
&eos_list
 gamma=1.6666666666666667d0
/
