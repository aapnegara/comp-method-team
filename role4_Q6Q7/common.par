! =====================================================================
! common.par  --  Role 4 (Q6 + Q7): everything that is IDENTICAL for all runs
!
! Use together with ONE scheme file; the scheme file is read second and
! overrides only the variables it lists:
!     mpirun -np 4 ./amrvac -i common.par schemes/woodward.par
!
! Based on frjets_caseB_cartesian_3d_final/smoke.par (Zoey's setup).
! TODO before production: copy domain_nx*, time_max, dtsave and courantpar
!      from Yitske's reference run, so our runs = "same run, other scheme".
! =====================================================================
&filelist
 ! base_filename is set in each schemes/*.par (unique output name per run)
 autoconvert=.true.
 convert_type='vtuBCCmpi'
 saveprim=.true.
 nwauxio=1
/
&savelist
 itsave(1,1)=0
 itsave(1,2)=0
 dtsave(1)=0.1d0
 dtsave(2)=0.1d0
/
&stoplist
 time_max=1.d0
 dtmin=1.d-12
/
&methodlist
 ! time_stepper, flux_scheme, limiter are set in each schemes/*.par
 small_values_method='error'   ! crash = result: note when/where, do not hide it
/
&boundlist
 nghostcells=2                 ! enough for all 7 schemes (mod_usr.t accepts 2 or 3)
 ! Five HD BC entries; tracer follows density (need_bc=F in this version).
 typeboundary_min1=5*'cont'
 typeboundary_max1=5*'cont'
 typeboundary_min2=5*'special'
 typeboundary_max2=5*'cont'
 typeboundary_min3=5*'cont'
 typeboundary_max3=5*'cont'
/
&meshlist
 refine_max_level=1            ! fixed grid, no AMR (required by Q6/Q7)
 block_nx1=8                   ! domain_nx must be a multiple of block_nx
 block_nx2=8
 block_nx3=8
 domain_nx1=96                 ! 96^3 -> 12 cells per jet radius
 domain_nx2=96
 domain_nx3=96
 xprobmin1=-4.d0
 xprobmax1=4.d0
 xprobmin2=0.d0
 xprobmax2=8.d0
 xprobmin3=-4.d0
 xprobmax3=4.d0
/
&paramlist
 courantpar=0.3d0              ! TODO: same value as Yitske's reference (0.3 or 0.8?)
 typecourant='maxsum'
/
&hd_list
 hd_energy=.true.
 hd_n_tracer=1
/
&eos_list
 gamma=1.6666666666666667d0
/
