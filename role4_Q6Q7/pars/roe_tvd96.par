! Role 4 (Q6/Q7): roe_tvd96 = onestep + tvd + minmod. Generated by gen_pars.sh from reference/smoke_wice_baseline96.par
! OPTIONAL Q7 run: AMRVAC forces onestep AND dimsplit=T for 'tvd', and the HD Roe
! eigen-system has no explicit tracer wave -> not a one-variable comparison.
&filelist
 base_filename='output/roe_tvd96'
 autoconvert=.true.
 convert_type='vtuBCCmpi'
 saveprim=.true.
 nwauxio=1
/
&savelist
 itsave(1,1)=0
 itsave(1,2)=0
 dtsave(1)=0.05d0
 dtsave(2)=0.25d0
/
&stoplist
 time_max=5.d0
 dtmin=1.d-12
/
&methodlist
 time_stepper='onestep'
 flux_scheme=20*'tvd'
 limiter=20*'minmod'
 small_values_method='error'
/
&boundlist
 nghostcells=2
 ! Five HD BC entries; tracer follows density (need_bc=F in this version).
 typeboundary_min1=5*'cont'
 typeboundary_max1=5*'cont'
 typeboundary_min2=5*'special'
 typeboundary_max2=5*'cont'
 typeboundary_min3=5*'cont'
 typeboundary_max3=5*'cont'
/
&meshlist
 refine_max_level=1
 block_nx1=8
 block_nx2=8
 block_nx3=8
 domain_nx1=96
 domain_nx2=96
 domain_nx3=96
 xprobmin1=-4.d0
 xprobmax1=4.d0
 xprobmin2=0.d0
 xprobmax2=8.d0
 xprobmin3=-4.d0
 xprobmax3=4.d0
/
&paramlist
 courantpar=0.3d0
 typecourant='maxsum'
/
&hd_list
 hd_energy=.true.
 hd_n_tracer=1
/
&eos_list
 gamma=1.6666666666666667d0
/
